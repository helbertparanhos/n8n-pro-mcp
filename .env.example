# Base URL of your n8n instance (no trailing slash, no /api/v1)
# Example: https://n8n.yourdomain.com
N8N_API_URL=

# n8n API key — create one in n8n: Settings → n8n API → Create API key
N8N_API_KEY=

# Optional: separate base URL for webhook calls (defaults to N8N_API_URL).
# Useful in queue mode when webhooks are served by dedicated webhook processors
# behind a different hostname.
N8N_WEBHOOK_BASE_URL=

# Optional: HTTP timeout per request in milliseconds (default: 30000)
N8N_API_TIMEOUT_MS=30000

# Optional: max retries for failed requests — 429/5xx/network (default: 3, 0 disables).
# Only GET requests are retried; writes and webhook calls never are.
# Note: unquoted values lose inline "#" comments; quote the value if it contains "#".
N8N_MAX_RETRIES=3
